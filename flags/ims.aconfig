package: "com.android.internal.telephony.flags"
container: "system"

# OWNER=hyosunkim TARGET=24Q2
flag {
    name: "conference_hold_unhold_changed_to_send_message"
    namespace: "telephony"
    description: "This flag controls Conference’s hold & unHold operation changed to send a message"
    bug:"288002989"
}

# OWNER=shmun TARGET=24Q3
flag {
    name: "add_rat_related_suggested_action_to_ims_registration"
    is_exported: true
    namespace: "telephony"
    description: "This flag is for adding suggested actions related to RAT to ims registration"
    bug:"290573256"
}

# OWNER=sewookseo TARGET=24Q3
flag {
    name: "emergency_registration_state"
    is_exported: true
    namespace: "telephony"
    description: "This flag is created to notify emergency registration state changed."
    bug:"312101946"
}

# OWNER=meghapatil TARGET=25Q2
flag {
    name: "support_sms_over_ims_apis"
    namespace: "telephony"
    description: "Used to expose SMS related hidden APIs for SMS over IMS to public API."
    bug:"359721349"
    is_exported: true
}

# OWNER=jhyoon TARGET=25Q2
flag {
    name: "support_ims_mmtel_interface"
    namespace: "telephony"
    description: "This flag controls the type of API regarding MmTelFeature, either hidden or system type."
    bug:"359721349"
    is_exported: true
}

# OWNER=yongnamcha TARGET=26Q2
flag {
    name: "support_throttle_time_for_deregistration"
    namespace: "telephony"
    description: "This flag controls whether the IMS registration throttling time is sent to the modem upon deregistration to support time-based carrier requirements."
    bug:"408139522"
    is_exported: true
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

# OWNER=gwenlin TARGET=26Q2
flag {
    name: "allowed_services"
    namespace: "telephony"
    description: "Update allowed services to the modem"
    bug:"389157806"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

# OWNER=vodduarun TARGET=25Q4
flag {
    name: "send_merge_failure_on_handle_conference_failed"
    namespace: "telephony"
    description: "This flag updates merge failure to clients when ImsCall rejects the merge request"
    bug:"418942310"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=gpiecyk TARGET=25Q4
flag {
    name: "enable_rtt_hold_carrier_config"
    namespace: "telephony"
    description: "This flag controls the availability and functionality of the KEY_ALLOW_HOLD_IN_RTT_CALL_BOOL carrier config."
    bug: "413765645"
    metadata {
        purpose: PURPOSE_FEATURE
    }
    is_exported: true
}

# OWNER=pmadapurmath TARGET=26Q4
flag {
    name: "enable_vt_call_low_battery_config"
    namespace: "telephony"
    description: "This flag controls the availability and functionality of the KEY_ALLOW_VIDEO_CALL_IN_LOW_BATTERY_BOOL carrier config."
    bug: "416476913"
    metadata {
        purpose: PURPOSE_FEATURE
    }
    is_exported: true
}

# OWNER=shashannk TARGET=26Q2
flag {
    name: "support_ims_sms_smma"
    namespace: "telephony"
    description: "This flag exposes sms memory availability notification related APIs"
    bug:"428178177"
    is_exported: true
}

# OWNER=gwenlin TARGET=26Q2
flag {
    name: "pcscf_address"
    namespace: "telephony"
    description: "This flag adds P-CSCF address in IMS registration attributes"
    bug:"433593483"
    is_exported: true
}

# OWNER=breadley TARGET=26Q3
flag {
  name: "init_rcs_provisioning_monitor_async"
  namespace: "telephony"
  description: "Init RcsProvisioningMonitor in a background thread to prevent ANR"
  bug: "469248684"
  metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=shashannk TARGET=26Q2
flag {
    name: "support_stk_send_raw_pdu_sms"
    namespace: "telephony"
    description: "This flag controls the STK SMS sending mechanism, using raw PDU instead of intent."
    bug:"467254147"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=arunrajms TARGET=26Q3
flag {
    name: "enable_vonr_check"
    namespace: "telephony"
    description: "This flag enables checking KEY_VONR_ENABLED_BOOL before enabling VoNR capability in ImsManager."
    bug: "476375119"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=shashannk TARGET=26Q2
flag {
    name: "stk_send_sms_terminal_response_on_send_success"
    namespace: "telephony"
    description: "This flag controls whether the terminal response for STK SMS is sent on send success or delivery success."
    bug:"480768765"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=shashannk TARGET=26Q2
flag {
    name: "stk_smsc_address_extraction"
    namespace: "telephony"
    description: "Extract and use SMSC Address from STK SEND SHORT MESSAGE command"
    bug: "480768765"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=shashannk TARGET=26Q2
flag {
    name: "skip_stk_short_code_check"
    namespace: "telephony"
    description: "Skip premium short code checks for STK SMS"
    bug: "491386743"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
