package: "com.android.internal.telephony.flags"
container: "system"

# OWNER=arunvoddu TARGET=24Q4 USED_BY_APP=true
flag {
    name: "carrier_restriction_status"
    is_exported: true
    namespace: "telephony"
    description: "This flag controls the visibility of the getCarrierRestrictionStatus in carrierRestrictionRules class."
    bug:"313553044"
}

# OWNER=rafahs TARGET=24Q3
flag {
    name: "esim_available_memory"
    is_exported: true
    namespace: "telephony"
    description: "This flag controls eSIM available memory feature."
    bug:"318348580"
}

# OWNER=arunvoddu TARGET=24Q4 USED_BY_APP=true
flag {
    name: "set_carrier_restriction_status"
    namespace: "telephony"
    description: "This flag controls the visibility of the setCarrierRestrictionStatus API in carrierRestrictionRules class."
    bug:"342411308"
    is_exported: true
}

# OWNER=jhyoon TARGET=25Q2
flag {
    name: "support_isim_record"
    namespace: "telephony"
    description: "This flag controls the type of API that retrieves ISIM records, either hidden or system type."
    bug:"359721349"
    is_exported: true
}

# OWNER=jinjeong TARGET=25Q2
flag {
    name: "carrier_id_from_carrier_identifier"
    namespace: "telephony"
    description: "This flag controls to get a carrier id using a carrier identifier."
    bug:"378778278"
    is_exported: true
}


# OWNER=juhokim TARGET=26Q2
flag {
    name: "support_stk_command_ussd_and_call"
    namespace: "telephony"
    description: "When enabled, SEND USSD and SET UP CALL commands from STK are handled through the telephony framework."
    bug:"404099417"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

# OWNER=muralidharm TARGET=25Q4
flag {
    name: "support_slot_switching_2psim_1esim_config"
    namespace: "telephony"
    description: "Flag to control supporting slow switching in 2pSIM+1eSIM configured devices"
    bug:"427638226"
    is_exported: true
}

# OWNER=jhyoon TARGET=26Q2
flag {
    name: "support_ims_registration_event_download"
    is_exported: true
    namespace: "telephony"
    description: "This flag controls whether support APIs for the USAT IMS registration event download feature."
    bug:"408143665"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

# OWNER=muralidharm TARGET=26Q1
flag {
    name: "slot_port_switch_failure_fix"
    namespace: "telephony"
    description: "This flag is to control the slot port switch failure fix during switching between different MEP modes."
    bug:"394709785"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

# OWNER=rgreenwalt TARGET=26Q2
flag {
    name: "new_sim_auth_permission"
    namespace: "telephony"
    description: "Add new permission to secure SIM auth"
    bug:"343796688"
}

# OWNER=nharold TARGET=26Q3
flag {
    name: "downloadable_subscription_include_carrier_identifier_internal"
    namespace: "telephony"
    description: "Add the CarrierIdentifier to the DownloadableSubscription"
    bug:"477378293"
}

# OWNER=gargakash TARGET=26Q3
flag {
    name: "fix_pin_storage_deadlock"
    namespace: "telephony"
    description: "Fixes deadlock between PinStorage and UiccController by narrowing synchronization scope"
    bug: "464075332"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}
